{
  "name": "shared-image-cache",
  "version": "1.0.0",
  "description": "Shared Unsplash image cache for all of nick's projects. Single rate-limit budget, deduplicated requests.",
  "private": false,
  "type": "commonjs",
  "scripts": {
    "seed": "npx tsx scripts/seed-from-projects.ts",
    "snapshot": "npx tsx scripts/snapshot-queries.ts",
    "fetch": "npx tsx scripts/fetch.ts",
    "stats": "node -e \"const c=require('./cache.json');const s={};for(const k of Object.keys(c))s[k.split('/')[0]]=(s[k.split('/')[0]]||0)+1;console.log('Total:',Object.keys(c).length);console.table(s)\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx scripts/selftest.ts",
    "gate": "npm run gate:fanout && npm run gate:venues && npm run gate:queries && npm run gate:snapshot && npm run gate:workflows",
    "gate:fanout": "tsx scripts/check-duplicate-fanout.ts",
    "gate:venues": "tsx scripts/check-venue-identity.ts",
    "gate:queries": "tsx scripts/check-query-hygiene.ts",
    "gate:snapshot": "tsx scripts/check-snapshot-drift.ts",
    "gate:workflows": "tsx scripts/check-workflow-projects.ts",
    "snapshot:check": "npx tsx scripts/snapshot-queries.ts --check"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
